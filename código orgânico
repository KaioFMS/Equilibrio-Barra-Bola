#include <Servo.h>
#include <PID_v1.h>

//A definir: angulo equilibrante = 90, reverse, limites do angulo ajuste e as constantes

//pinos do sensor
const int echo = 9;
const int trig = 8;

Servo meuservo;

const int angulo_equilibrante = 90;

//parâmetros do PID
double distancia = 0.0, angulo_ajuste = 0.0, setpoint = 20.0;
double kp = 0.7, ki = 0.0, kd = 1.0;

//váriavel para conferir se o sensor está lendo a bolinha
float resposta = 0.0;

//          input    ,  output       ,  setpoint              REVERSE???
PID meuPID(&distancia, &angulo_ajuste, &setpoint, kp, ki, kd, REVERSE);

void setup(){
	Serial.begin(9600);
  	
  	//sensor
  	pinMode(trig, OUTPUT);
	pinMode(echo, INPUT);
  
  	//servo
  	meuservo.attach(10);
  	
  	//ângulo inicial do servo
  	meuservo.write(angulo_equilibrante);
  	
  	//funções do PID
  	meuPID.SetMode(AUTOMATIC);
  	meuPID.SetSampleTime(50);
  	meuPID.SetOutputLimits(-45, 45);
}

float calculaDist(){
	digitalWrite(trig, LOW);
  	delayMicroseconds(2);
 	digitalWrite(trig, HIGH);
  	delayMicroseconds(10);
  	digitalWrite(trig, LOW);
  	
  	long duracao = pulseIn(echo, HIGH, 30000);
  	if (duracao == 0){
  		return -1.0;
    }
	
  	return duracao * 0.0343 / 2;
}

void loop(){
	resposta = (calculaDist());
  	if (resposta != -1.0){     // só computa as leituras se identificar a bolinha
      	distancia = resposta;
  		meuPID.Compute();
    }//                                + (P + I + D)
  	meuservo.write(angulo_equilibrante + angulo_ajuste);
  	
  	// plotar o gráfico 
  	Serial.print(setpoint);
  	Serial.print(" ");
  	Serial.print(distancia);
  	Serial.print(" ");
	Serial.print(angulo_equilibrante + angulo_ajuste);
  	Serial.println(" ");
  
  	delay(150);
}
